# ── Secrets and local configuration ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
# never commit a private key; the public verification key is the one exception
*.pem
*.key
!.sentinel/pubkey.pem
.pins/

# ── Python ───────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.eggs/
/build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node (frontend, VS Code extension) ───────────────────────────────────────────
node_modules/
.cache/
*.vsix
# the one packaged extension the website offers for download (a test checks it matches vscode-extension/)
!frontend/sentinel-md.vsix

# ── OS and editors ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log

# ── Generated by Sentinel, the demo and the benchmarks ───────────────────────────
# fixtures, scratch reproductions, PR comment output
fx/
repro/
.temp_scan
sentinel-comment.md
# corpora rebuilt by bench/wildscan.py (large; the manifests in bench/results/ are what we track)
# downloaded benchmark corpora (large, re-creatable). The two files that document the adversarial-corpus run ARE tracked:
# a bare `corpus/` rule once swallowed them silently, and the README linked to a page that did not exist.
/corpus/
/benchmark/
/heldout/
bench/corpus/*
!bench/corpus/README.md
!bench/corpus/sentinel_adapter.py
bench/heldout/
# ad-hoc evaluation output; the two published result files are tracked on purpose
results*.json
!bench/detonation/results/*.json

# local, machine-specific benchmark baselines (see bench/precision_gate.py)
*.local.json
