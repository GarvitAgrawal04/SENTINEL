{
  "name": "sentinel-md",
  "displayName": "Sentinel",
  "description": "Underlines what a file would make your AI coding agent do. Needs the Sentinel API running on your machine.",
  "version": "0.2.0",
  "publisher": "sentinel",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/GarvitAgrawal04/SENTINEL" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "sentinel.scanFile", "title": "Sentinel: Scan this file" },
      { "command": "sentinel.showReport", "title": "Sentinel: Show the full report" }
    ],
    "configuration": {
      "title": "Sentinel",
      "properties": {
        "sentinel.apiUrl": { "type": "string", "default": "http://127.0.0.1:8000", "description": "Where the Sentinel API is running. Keep it on your own machine so nothing you scan leaves it." }
      }
    }
  }
}
