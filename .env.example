# Sentinel needs NO environment variables for static scanning, the gate, or AGENTS.lock verification.

# --- Detonation chamber (optional): bring your own hosted model. One API key + a model name. ---
# Set a provider (fills in the endpoint for you) OR a full SENTINEL_LLM_URL. Choose a small, cheap model.
SENTINEL_LLM_KEY=your-api-key            # ONE key. The runner paces itself; it does not rotate keys.
SENTINEL_LLM_PROVIDER=openai          # openai | groq | together | anthropic | mistral | openrouter | deepinfra
SENTINEL_LLM_MODEL=gpt-4o-mini        # groq: llama-3.3-70b-versatile | anthropic: claude-3-5-haiku-latest
# SENTINEL_LLM_RPM=20                   # requests per minute (0 = no pacing)
# SENTINEL_LLM_URL=https://your-endpoint/v1   # only for an OpenAI-compatible endpoint not listed above

# --- CI signing only. Store the PEM in a protected GitHub environment secret, never in a file here. ---
# SENTINEL_SIGNING_KEY=

# Frontend (frontend/.env.local, not committed):  VITE_API_URL=http://localhost:8001
