# layer3 — .env.example
#
# Copy this file to .env and fill in your real Groq API key.
# Never commit the real .env file to version control.
#
# The layer3 analyzer reads GROQ_API_KEY from the environment at
# call time.  If the variable is absent, analyze() returns a clear error
# naming this variable rather than failing silently.

GROQ_API_KEY=gsk_your-key-here
