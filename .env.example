# Copy this file to .env (setup.sh does it for you). .env is git-ignored. Never commit it.
#
# YOU CAN LEAVE EVERYTHING EMPTY. The API server, the scanner, the gate and AGENTS.lock verification need no
# environment variables and no API key. Only the optional "detonation" feature talks to a model provider.
#
# Format: KEY=value, one per line, no quotes needed, comments on their own lines.

# ── Local server (used by setup.sh and the Makefile) ─────────────────────────────────────────────────────────────
# Address and port the API listens on. The web UI and the VS Code extension expect port 8000.
HOST=127.0.0.1
PORT=8000

# ── Detonation chamber (optional) ────────────────────────────────────────────────────────────────────────────────
# Runs an instruction file past a sandboxed model with fake tools and planted canary secrets.
# Used by: `sentinel detonate`, `sentinel pr --detonate`, bench/detonation/run_detonation_eval.py
#
# Your API key for the provider below. ONE key. Leave empty to keep detonation switched off.
SENTINEL_LLM_KEY=
# Which hosted provider the key belongs to: openai | groq | together | anthropic | mistral | openrouter | deepinfra
SENTINEL_LLM_PROVIDER=groq
# A small, cheap, tool-calling model at that provider. Examples: openai/gpt-oss-20b (groq), gpt-4o-mini (openai)
SENTINEL_LLM_MODEL=openai/gpt-oss-20b
# Requests per minute Sentinel allows itself (0 = no pacing). Lower it if the provider keeps answering 429.
SENTINEL_LLM_RPM=20
# Only for an OpenAI-compatible endpoint that is not in the provider list. Overrides SENTINEL_LLM_PROVIDER.
SENTINEL_LLM_URL=

# ── Rarely needed ────────────────────────────────────────────────────────────────────────────────────────────────
# Where `sentinel verify` remembers public-key fingerprints (default: ~/.config/sentinel).
SENTINEL_HOME=
# Raises GitHub's rate limit for bench/wildscan.py, which rebuilds the 930-repository corpus. Not needed otherwise.
GITHUB_TOKEN=

# ── NOT for this file ────────────────────────────────────────────────────────────────────────────────────────────
# SENTINEL_SIGNING_KEY (the ed25519 private key that signs AGENTS.lock) belongs in a protected CI secret only.
# The web UI needs no configuration when the API serves it. For a separately hosted copy, edit frontend/config.js.
