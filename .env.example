# Sentinel needs no environment variables for static scanning, the gate, or AGENTS.lock verification.

# Detonation chamber (optional). Any OpenAI-compatible endpoint with tool calling. Offline default: Ollama.
SENTINEL_LLM_URL=http://localhost:11434/v1
SENTINEL_LLM_MODEL=your-tool-calling-model
# SENTINEL_LLM_KEY=only-for-hosted-endpoints

# CI signing only. Store the PEM in a protected GitHub environment secret. Never in a file in this repository.
# SENTINEL_SIGNING_KEY=

# Frontend (frontend/.env.local, not committed):  VITE_API_URL=http://localhost:8001
